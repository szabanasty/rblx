{
  "name": "rblx",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "Baseplate": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512],
          "Color": [0.3, 0.3, 0.3],
          "Material": "Concrete",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Position": [0, 0.5, 0],
          "Size": [6, 1, 6],
          "Color": [0.2, 0.6, 0.4],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    }
  }
}
