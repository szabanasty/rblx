{
  "name": "rblx",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Action": {
          "$className": "RemoteEvent"
        },
        "Input": {
          "$className": "RemoteEvent"
        },
        "Snapshot": {
          "$className": "RemoteEvent"
        },
        "Feedback": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "Baseplate": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            800,
            20,
            800
          ],
          "Color": [
            0.3,
            0.3,
            0.3
          ],
          "Material": "Concrete",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Neutral": true,
          "Position": [
            0,
            0.5,
            0
          ],
          "Size": [
            6,
            1,
            6
          ],
          "Color": [
            0.2,
            0.6,
            0.4
          ],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth",
          "Duration": 0
        }
      },
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 256
      },
      "Map": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "SafeZone": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Roads": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "CombatZone": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "FishingArea": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Garage": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Shops": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Buildings": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Cover": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      },
      "Vehicles": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "ScooterModels": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "EquipmentTemplates": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    }
  }
}
